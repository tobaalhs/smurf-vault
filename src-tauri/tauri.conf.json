{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smurf Vault",
  "version": "../package.json",
  "identifier": "com.tobaalhs.smurfvault",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Smurf Vault",
        "width": 1180,
        "height": 780,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0a0e13"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
